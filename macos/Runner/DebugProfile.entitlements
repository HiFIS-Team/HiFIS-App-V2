<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- 서버 API 호출에 필요하다. 없으면 샌드박스가 나가는 요청을 전부 막아
	     macOS에서만 로그인이 안 된다 (실제 발생). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 문서함: 올릴 파일 고르기(읽기) + 내려받아 저장하기(쓰기).
	     read-only 로 두면 저장 창은 뜨는데 쓰기에서 막힌다. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 푸시 알림. 개발 빌드는 애플의 **개발용** 서버를 쓴다
	     (Release.entitlements 는 production).
	     **키 이름이 iOS 와 다르다** — iOS 는 `aps-environment`, macOS 는
	     `com.apple.developer.` 가 앞에 붙는다. 틀리면 서명에서 조용히 빠진다. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- 로그인 토큰을 키체인에 넣는다 — 샌드박스 앱은 이 게 없으면
	     키체인 접근이 전부 실패해서 매번 다시 로그인해야 한다 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.hifis.hifis</string>
	</array>
</dict>
</plist>
