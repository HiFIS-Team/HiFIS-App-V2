<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12(API 31)+ 전용 런치 테마.

     이 버전부터 OS 가 앱보다 먼저 스플래시를 그린다. 기본값이 앱 아이콘이라
     **작은 아이콘 → 110dp 마크**로 튀어서, 아이콘 자리를 투명으로 비우고
     배경만 흰색으로 맞춘다. 마크는 launch_background 가 그린다.

     values/styles.xml 의 LaunchTheme 을 통째로 덮어쓰는 것이라 parent 와
     windowBackground 도 같이 적는다 (항목 단위로 안 섞인다). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_splash_icon</item>
    </style>
</resources>
